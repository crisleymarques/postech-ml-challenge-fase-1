        "    \"relacionamento_marketing\": [\"Quarter\", \"ReferredaFriend\", \"NumberofReferrals\", \"TenureinMonths\", \"Offer\"],\n",
        "    \"servicos\": [\n",
        "        \"PhoneService\", \"MultipleLines\", \"InternetService\", \"InternetType\",\n",
        "        \"OnlineSecurity\", \"OnlineBackup\", \"DeviceProtectionPlan\", \"PremiumTechSupport\",\n",
        "        \"StreamingTV\", \"StreamingMovies\", \"StreamingMusic\", \"UnlimitedData\",\n",
        "    ],\n",
        "    \"plano_pagamento\": [\"Contract\", \"PaperlessBilling\", \"PaymentMethod\"],\n",
        "    \"financeiro\": [\n",
        "        \"MonthlyCharge\", \"TotalCharges\", \"TotalRefunds\",\n",
        "        \"TotalExtraDataCharges\", \"TotalLongDistanceCharges\", \"TotalRevenue\",\n",
        "    ],\n",
        "    \"satisfacao_churn\": [\n",
        "        \"SatisfactionScore\", \"CustomerStatus\", \"ChurnLabel\", \"ChurnValue\",\n",
        "        \"ChurnScore\", \"CLTV\", \"ChurnCategory\", \"ChurnReason\", TARGET_COLUMN,\n",
        "    ],\n",
        "}\n",
        "\n",
        "dictionary_rows = [\n",
        "    {\"group\": group, \"column\": column, \"present\": column in df.columns}\n",
        "    for group, columns in DATA_DICTIONARY.items()\n",
        "    for column in columns\n",
        "]\n",
        "display(pd.DataFrame(dictionary_rows))\n"
      ]
    },
