    "print(\"Outliers por Z-score absoluto > 3\")\n",
    "outlier_rows = []\n",
    "for column in numeric_cols:\n",
    "    series = df_eda[column].dropna()\n",
    "    std = series.std(ddof=0)\n",
    "    z_scores = pd.Series(np.zeros(len(series)), index=series.index) if std == 0 else (series - series.mean()) / std\n",
    "    outlier_rows.append(\n",
    "        {\n",
    "            \"column\": column,\n",
    "            \"outliers_z_gt_3\": int(z_scores.abs().gt(3).sum()),\n",
    "            \"outlier_rate\": float(z_scores.abs().gt(3).mean()),\n",
    "            \"min\": float(series.min()),\n",
    "            \"median\": float(series.median()),\n",
    "            \"max\": float(series.max()),\n",
    "        }\n",
    "    )\n",
    "outlier_summary = pd.DataFrame(outlier_rows).sort_values(\"outliers_z_gt_3\", ascending=False)\n",
    "display(outlier_summary)\n",
    "\n",
    "if len(numeric_cols) > 0:\n",
    "    ncols = 3\n",
    "    nrows = int(np.ceil(len(numeric_cols) / ncols))\n",
    "    fig, axes = plt.subplots(nrows, ncols, figsize=(14, 4 * nrows))\n",
    "    axes = np.array(axes).ravel()\n",
    "    for idx, column in enumerate(numeric_cols):\n",
    "        sns.boxplot(x=df_eda[column], ax=axes[idx], color=\"coral\")\n",
    "        outliers = outlier_summary.loc[outlier_summary[\"column\"] == column, \"outliers_z_gt_3\"].iloc[0]\n",
    "        axes[idx].set_title(f\"Boxplot: {column}\\nZ>|3|: {outliers}\")\n",
    "        axes[idx].grid(axis=\"x\", alpha=0.3)\n",
    "    for idx in range(len(numeric_cols), len(axes)):\n",
    "        fig.delaxes(axes[idx])\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n"
   ]
