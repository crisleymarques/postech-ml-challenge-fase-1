        "def sha256_file(path: Path) -> str:\n",
        "    digest = hashlib.sha256()\n",
        "    with path.open(\"rb\") as file:\n",
        "        for chunk in iter(lambda: file.read(1024 * 1024), b\"\"):\n",
        "            digest.update(chunk)\n",
        "    return digest.hexdigest()\n",
        "\n",
        "PROCESSED_DIR.mkdir(parents=True, exist_ok=True)\n",
        "model_df.to_csv(FINAL_DATASET_PATH, index=False)\n",
        "dataset_sha256 = sha256_file(FINAL_DATASET_PATH)\n",
        "\n",
        "manifest = {\n",
        "    \"dataset_name\": \"telco_churn_model_ready\",\n",
        "    \"dataset_version\": dataset_sha256,\n",
        "    \"created_at_utc\": datetime.now(timezone.utc).isoformat(),\n",
        "    \"random_seed\": RANDOM_SEED,\n",
        "    \"source_type\": source_type,\n",
        "    \"source_files\": source_files,\n",
        "    \"output_file\": str(FINAL_DATASET_PATH.relative_to(PROJECT_ROOT)),\n",
        "    \"output_sha256\": dataset_sha256,\n",
        "    \"target_column\": TARGET_COLUMN,\n",
        "    \"rows\": int(model_df.shape[0]),\n",
        "    \"columns\": int(model_df.shape[1]),\n",
        "    \"feature_columns\": int(model_df.shape[1] - 1),\n",
        "    \"target_distribution\": {\n",
        "        str(key): int(value)\n",
        "        for key, value in model_df[TARGET_COLUMN].value_counts().sort_index().items()\n",
        "    },\n",
        "    \"target_positive_rate\": float(model_df[TARGET_COLUMN].mean()),\n",
        "    \"removed_columns\": columns_to_remove,\n",
        "    \"removed_constant_columns\": constant_columns,\n",
        "    \"notes\": [\n",
        "        \"Dataset final contem features observaveis e target binario.\",\n",
        "        \"Colunas de churn posterior, status, score, motivo/categoria, IDs e CLTV foram removidas para reduzir leakage.\",\n",
        "        \"Transformacoes estatisticas como imputacao, escala e one-hot devem ser ajustadas apenas no treino no notebook 02.\",\n",
        "    ],\n",
        "}\n",
        "MANIFEST_PATH.write_text(json.dumps(manifest, indent=2, ensure_ascii=False), encoding=\"utf-8\")\n",
        "\n",
        "import mlflow\n",
