        "numeric_candidates = [\n",
        "    col\n",
        "    for col in [\"TenureinMonths\", \"MonthlyCharge\", \"TotalCharges\", \"TotalRevenue\", \"Age\", \"SatisfactionScore\"]\n",
        "    if col in df.columns\n",
        "]\n",
        "fig, ax = plt.subplots(figsize=(8, max(3, len(numeric_candidates) * 0.35)))\n",
        "if numeric_candidates:\n",
        "    corr = (\n",
        "        df[numeric_candidates + [TARGET_COLUMN]]\n",
        "        .corr(numeric_only=True)[TARGET_COLUMN]\n",
        "        .drop(TARGET_COLUMN)\n",
        "        .sort_values(key=lambda s: s.abs(), ascending=False)\n",
        "    )\n",
        "    sns.barplot(x=corr.values, y=corr.index, ax=ax)\n",
        "    ax.set_title(\"Correlação linear com target\")\n",
        "else:\n",
        "    ax.text(0.5, 0.5, \"Sem colunas numéricas candidatas\", ha=\"center\")\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "for column in [\"Contract\", \"InternetService\", \"InternetType\", \"PaymentMethod\", \"Offer\"]:\n",
        "    if column in df.columns:\n",
        "        churn_by_category = (\n",
        "            df.groupby(column, dropna=False)[TARGET_COLUMN]\n",
        "            .agg(churn_rate=\"mean\", customers=\"size\")\n",
        "            .sort_values(\"churn_rate\", ascending=False)\n",
        "        )\n",
        "        print(f\"Churn por {column}\")\n",
        "        display(churn_by_category.head(15))\n"
      ]
    },
