      "source": [
        "def clean_column_names(df: pd.DataFrame) -> pd.DataFrame:\n",
        "    renamed = {\n",
        "        column: str(column).strip().replace(\" \", \"\").replace(\"_\", \"\")\n",
        "        for column in df.columns\n",
        "    }\n",
        "    return df.rename(columns=renamed)\n",
        "\n",
        "\n",
        "def raw_files_available() -> bool:\n",
        "    return all((DATA_DIR / file_name).exists() for file_name in RAW_DATA_FILES.values())\n",
        "\n",
        "\n",
        "def load_raw_telco_dataset() -> tuple[pd.DataFrame, str, list[str]]:\n",
        "    tables = {}\n",
        "    source_files = []\n",
        "    for table_name, file_name in RAW_DATA_FILES.items():\n",
        "        path = DATA_DIR / file_name\n",
        "        tables[table_name] = clean_column_names(pd.read_excel(path, sheet_name=0)).drop(\n",
        "            columns=[\"Count\"], errors=\"ignore\"\n",
        "        )\n",
        "        source_files.append(file_name)\n",
        "\n",
        "    df = (\n",
        "        tables[\"demographics\"]\n",
        "        .merge(tables[\"location\"], on=\"CustomerID\")\n",
        "        .merge(tables[\"services\"], on=\"CustomerID\")\n",
        "        .merge(tables[\"population\"], on=\"ZipCode\")\n",
        "        .merge(tables[\"status\"], on=\"CustomerID\")\n",
        "        .drop(columns=[\"ID\"], errors=\"ignore\")\n",
        "    )\n",
        "    return df, \"raw_excel\", source_files\n",
        "\n",
        "\n",
        "def load_telco_dataset() -> tuple[pd.DataFrame, str, list[str]]:\n",
        "    if raw_files_available():\n",
        "        return load_raw_telco_dataset()\n",
        "    if not ENCODED_FALLBACK.exists():\n",
        "        raise FileNotFoundError(\n",
        "            \"Nenhum arquivo bruto ou CSV fallback encontrado em data/.\"\n",
        "        )\n",
        "    return pd.read_csv(ENCODED_FALLBACK), \"encoded_csv_fallback\", [ENCODED_FALLBACK.name]\n",
        "\n",
        "\n",
        "df_raw, source_type, source_files = load_telco_dataset()\n",
        "print(f\"Fonte usada: {source_type}\")\n",
        "print(f\"Arquivos: {source_files}\")\n",
        "print(f\"Shape bruto: {df_raw.shape[0]:,} linhas x {df_raw.shape[1]:,} colunas\")\n",
        "display(df_raw.head())"
      ]
    },
