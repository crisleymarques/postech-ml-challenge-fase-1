        "print(\"Distribuições: assimetria e curtose\")\n",
        "distribution_stats = []\n",
        "for column in numeric_cols:\n",
        "    skewness = df_eda[column].skew()\n",
        "    kurtosis = df_eda[column].kurtosis()\n",
        "    distribution_stats.append(\n",
        "        {\n",
        "            \"column\": column,\n",
        "            \"skewness\": round(float(skewness), 3),\n",
        "            \"kurtosis\": round(float(kurtosis), 3),\n",
        "            \"interpretation\": \"aprox. simétrica\" if abs(skewness) < 0.5 else (\"assimétrica à direita\" if skewness > 0 else \"assimétrica à esquerda\"),\n",
        "        }\n",
        "    )\n",
        "distribution_df = pd.DataFrame(distribution_stats).sort_values(\"skewness\", key=lambda s: s.abs(), ascending=False)\n",
        "display(distribution_df)\n",
        "\n",
        "if len(numeric_cols) > 0:\n",
        "    ncols = 3\n",
        "    nrows = int(np.ceil(len(numeric_cols) / ncols))\n",
        "    fig, axes = plt.subplots(nrows, ncols, figsize=(14, 4 * nrows))\n",
        "    axes = np.array(axes).ravel()\n",
        "    for idx, column in enumerate(numeric_cols):\n",
        "        sns.histplot(df_eda[column].dropna(), bins=30, kde=False, ax=axes[idx], color=\"skyblue\", edgecolor=\"black\")\n",
        "        skewness = distribution_df.loc[distribution_df[\"column\"] == column, \"skewness\"].iloc[0]\n",
        "        axes[idx].set_title(f\"{column}\\nSkew: {skewness:.2f}\")\n",
        "        axes[idx].grid(axis=\"y\", alpha=0.3)\n",
        "    for idx in range(len(numeric_cols), len(axes)):\n",
        "        fig.delaxes(axes[idx])\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n"
      ]
