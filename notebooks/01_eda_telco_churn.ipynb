      "source": [
        "print(\"Correlação entre variáveis numéricas\")\n",
        "corr_numeric = df_eda.select_dtypes(include=[np.number]).corr(numeric_only=True)\n",
        "display(corr_numeric)\n",
        "\n",
        "plt.figure(figsize=(16, 12))\n",
        "sns.heatmap(\n",
        "    corr_numeric,\n",
        "    annot=True,\n",
        "    fmt=\".2f\",\n",
        "    cmap=\"coolwarm\",\n",
        "    center=0,\n",
        "    square=False,\n",
        "    linewidths=0.5,\n",
        "    cbar_kws={\"shrink\": 0.8},\n",
        ")\n",
        "plt.title(\"Matriz de correlação das variáveis numéricas\")\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "if TARGET_COLUMN in corr_numeric.columns:\n",
        "    target_corr = (\n",
        "        corr_numeric[TARGET_COLUMN]\n",
        "        .drop(TARGET_COLUMN, errors=\"ignore\")\n",
        "        .sort_values(key=lambda s: s.abs(), ascending=False)\n",
        "        .rename(\"correlation_with_target\")\n",
        "        .reset_index()\n",
        "        .rename(columns={\"index\": \"column\"})\n",
        "    )\n",
        "    display(target_corr)\n",
        "\n",
        "high_corr_pairs = []\n",
        "corr_columns = corr_numeric.columns.tolist()\n",
        "for left_idx, left_column in enumerate(corr_columns):\n",
        "    for right_column in corr_columns[left_idx + 1 :]:\n",
        "        corr_value = corr_numeric.loc[left_column, right_column]\n",
        "        if left_column == TARGET_COLUMN or right_column == TARGET_COLUMN:\n",
        "            continue\n",
        "        if abs(corr_value) > 0.70:\n",
        "            high_corr_pairs.append(\n",
        "                {\n",
        "                    \"feature_1\": left_column,\n",
        "                    \"feature_2\": right_column,\n",
        "                    \"correlation\": round(float(corr_value), 3),\n",
        "                }\n",
        "            )\n",
        "\n",
        "high_corr_df = pd.DataFrame(high_corr_pairs).sort_values(\"correlation\", key=lambda s: s.abs(), ascending=False)\n",
        "display(high_corr_df)\n",
        "\n",
        "specific_corr_columns = [\n",
        "    \"TotalLongDistanceCharges\",\n",
        "    \"AvgMonthlyLongDistanceCharges\",\n",
        "    \"TenureinMonths\",\n",
        "]\n",
        "if set(specific_corr_columns).issubset(df_eda.columns):\n",
        "    print(\"Correlação específica (notebook histórico)\")\n",
        "    display(df_eda[specific_corr_columns].corr())\n"
      ]
    },
