      "source": [
        "target_distribution = (\n",
        "    df[TARGET_COLUMN]\n",
        "    .value_counts(normalize=False)\n",
        "    .rename_axis(\"target\")\n",
        "    .reset_index(name=\"count\")\n",
        ")\n",
        "target_distribution[\"rate\"] = target_distribution[\"count\"] / target_distribution[\"count\"].sum()\n",
        "display(target_distribution)\n",
        "\n",
        "target_counts = df[TARGET_COLUMN].value_counts().sort_index()\n",
        "target_pct = df[TARGET_COLUMN].value_counts(normalize=True).sort_index() * 100\n",
        "print(\"Percentual por classe:\")\n",
        "for idx in target_pct.index:\n",
        "    label = \"Não cancelou\" if idx == 0 else \"Cancelou\"\n",
        "    print(f\"  {label} ({idx}): {target_pct.loc[idx]:.2f}%\")\n",
        "\n",
        "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
        "axes[0].bar([\"Não cancelou\", \"Cancelou\"], target_counts.reindex([0, 1], fill_value=0).values, color=[\"lightblue\", \"coral\"])\n",
        "axes[0].set_ylabel(\"Frequência\")\n",
        "axes[0].set_title(\"Distribuição da variável target\")\n",
        "axes[0].grid(axis=\"y\", alpha=0.3)\n",
        "\n",
        "axes[1].pie(\n",
        "    target_counts.reindex([0, 1], fill_value=0).values,\n",
        "    labels=[\"Não cancelou\", \"Cancelou\"],\n",
        "    autopct=\"%1.1f%%\",\n",
        "    colors=[\"lightblue\", \"coral\"],\n",
        "    startangle=90,\n",
        ")\n",
        "axes[1].set_title(\"Proporção de classes\")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "ratio = float(target_counts.min() / target_counts.max())\n",
        "print(f\"\\nRatio (menor classe / maior classe): {ratio:.2f}\")\n",
        "if ratio < 0.5:\n",
        "    print(\"Classes desbalanceadas: na modelagem, avaliar F1, precision, recall e PR-AUC além da acurácia.\")\n"
      ]
