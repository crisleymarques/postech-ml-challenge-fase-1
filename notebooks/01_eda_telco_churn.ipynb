        "with mlflow.start_run(run_name=f\"dataset-{dataset_sha256[:12]}\") as ds_run:\n",
        "    mlflow.set_tag(\"dataset_kind\", \"telco_churn_model_ready\")\n",
        "    mlflow.set_tag(\"output_sha256\", dataset_sha256)\n",
        "    mlflow.log_param(\"dataset_version\", manifest[\"dataset_version\"])\n",
        "    mlflow.log_param(\"rows\", manifest[\"rows\"])\n",
        "    mlflow.log_param(\"columns\", manifest[\"columns\"])\n",
        "    mlflow.log_param(\"source_type\", str(manifest[\"source_type\"]))\n",
        "    mlflow.log_artifact(str(FINAL_DATASET_PATH), artifact_path=\"dataset\")\n",
        "    mlflow.log_artifact(str(MANIFEST_PATH), artifact_path=\"dataset\")\n",
        "    published_run_id = ds_run.info.run_id\n",
        "\n",
        "print(f\"Dataset final (disco): {FINAL_DATASET_PATH}\")\n",
        "print(f\"Manifesto (disco): {MANIFEST_PATH}\")\n",
