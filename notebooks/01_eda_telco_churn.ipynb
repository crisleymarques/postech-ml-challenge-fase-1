   "source": [
    "print(\"Validações de domínio e anomalias\")\n",
    "validation_results: list[dict[str, object]] = []\n",
    "\n",
    "\n",
    "def add_validation(check: str, invalid_count: int, details: str) -> None:\n",
    "    validation_results.append(\n",
    "        {\n",
    "            \"check\": check,\n",
    "            \"invalid_count\": int(invalid_count),\n",
    "            \"status\": \"ok\" if invalid_count == 0 else \"review\",\n",
    "            \"details\": details,\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "if \"Age\" in df_eda.columns:\n",
    "    invalid_age = df_eda[\"Age\"].lt(0) | df_eda[\"Age\"].gt(120)\n",
    "    add_validation(\"Age entre 0 e 120\", invalid_age.sum(), \"Intervalo esperado: 0 <= Age <= 120\")\n",
    "\n",
    "if \"SatisfactionScore\" in df_eda.columns:\n",
    "    invalid_satisfaction = df_eda[\"SatisfactionScore\"].lt(1) | df_eda[\"SatisfactionScore\"].gt(5)\n",
    "    add_validation(\"SatisfactionScore entre 1 e 5\", invalid_satisfaction.sum(), \"Escala esperada: 1 a 5\")\n",
    "\n",
    "allowed_values = {\n",
    "    \"Offer\": {\"Offer A\", \"Offer B\", \"Offer C\", \"Offer D\", \"Offer E\", \"None\", \"No Offer\"},\n",
    "    \"InternetType\": {\"Cable\", \"DSL\", \"Fiber Optic\"},\n",
    "    \"PaymentMethod\": {\"Bank Withdrawal\", \"Credit Card\", \"Mailed Check\"},\n",
    "}\n",
    "for column, valid_values in allowed_values.items():\n",
    "    if column in df_eda.columns:\n",
    "        invalid = df_eda[column].notna() & ~df_eda[column].isin(valid_values)\n",
    "        add_validation(\n",
    "            f\"{column} dentro do domínio conhecido\",\n",
    "            invalid.sum(),\n",
    "            f\"Valores observados: {sorted(map(str, df_eda[column].dropna().unique()))}\",\n",
    "        )\n",
    "\n",
    "boolean_like_columns = [\n",
    "    \"OnlineSecurity\", \"OnlineBackup\", \"DeviceProtectionPlan\", \"PremiumTechSupport\",\n",
    "    \"SeniorCitizen\", \"Married\", \"Dependents\", \"Under30\", \"ReferredaFriend\",\n",
    "    \"PhoneService\", \"MultipleLines\", \"StreamingTV\", \"StreamingMovies\",\n",
    "    \"StreamingMusic\", \"UnlimitedData\", \"PaperlessBilling\", \"ChurnLabel\",\n",
    "]\n",
    "for column in boolean_like_columns:\n",
    "    if column in df_eda.columns:\n",
    "        invalid = df_eda[column].notna() & ~df_eda[column].isin([\"No\", \"Yes\", 0, 1, False, True])\n",
    "        add_validation(f\"{column} binária Yes/No\", invalid.sum(), \"Domínio esperado: Yes/No\")\n",
    "\n",
    "add_validation(\"Registros duplicados\", df_eda.duplicated().sum(), \"duplicated() no dataframe completo\")\n",
    "validation_df = pd.DataFrame(validation_results)\n",
    "display(validation_df)\n",
    "\n",
    "columns_to_exclude_from_numeric_eda = [TARGET_COLUMN, \"Latitude\", \"Longitude\"]\n",
    "numeric_cols = df_eda.select_dtypes(include=[np.number]).columns.drop(\n",
    "    columns_to_exclude_from_numeric_eda,\n",
    "    errors=\"ignore\",\n",
    ")\n"
   ]
  },
