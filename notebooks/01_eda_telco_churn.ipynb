      "source": [
        "def leakage_columns_present(columns: pd.Index) -> list[str]:\n",
        "    explicit = [column for column in columns if column in ID_COLUMNS | LEAKAGE_COLUMNS | TEMPORAL_RISK_COLUMNS]\n",
        "    prefixed = [\n",
        "        column\n",
        "        for column in columns\n",
        "        if any(str(column).startswith(prefix) for prefix in LEAKAGE_PREFIXES)\n",
        "    ]\n",
        "    return sorted(set(explicit + prefixed))\n",
        "\n",
        "columns_before = df.columns.tolist()\n",
        "columns_to_remove = leakage_columns_present(df.columns)\n",
        "model_df = df.drop(columns=columns_to_remove, errors=\"ignore\").copy()\n",
        "\n",
        "constant_columns = [\n",
        "    column\n",
        "    for column in model_df.columns\n",
        "    if column != TARGET_COLUMN and model_df[column].nunique(dropna=False) <= 1\n",
        "]\n",
        "model_df = model_df.drop(columns=constant_columns, errors=\"ignore\")\n",
        "\n",
        "feature_columns = [column for column in model_df.columns if column != TARGET_COLUMN]\n",
        "model_df = model_df[feature_columns + [TARGET_COLUMN]]\n",
        "\n",
        "summary = pd.DataFrame(\n",
        "    {\n",
        "        \"item\": [\n",
        "            \"source_type\",\n",
        "            \"rows_final\",\n",
        "            \"columns_before\",\n",
        "            \"columns_final\",\n",
        "            \"removed_leakage_or_id_columns\",\n",
        "            \"removed_constant_columns\",\n",
        "            \"target_positive_rate\",\n",
        "        ],\n",
        "        \"value\": [\n",
        "            source_type,\n",
        "            len(model_df),\n",
        "            len(columns_before),\n",
        "            model_df.shape[1],\n",
        "            len(columns_to_remove),\n",
        "            len(constant_columns),\n",
        "            model_df[TARGET_COLUMN].mean(),\n",
        "        ],\n",
        "    }\n",
        ")\n",
        "display(summary)\n",
        "print(\"Colunas removidas por leakage/ID/risco temporal:\")\n",
        "display(pd.Series(columns_to_remove, name=\"removed_columns\").to_frame())\n",
        "print(\"Colunas constantes removidas:\")\n",
        "display(pd.Series(constant_columns, name=\"constant_columns\").to_frame())\n",
        "display(model_df.head())"
      ]
    },
