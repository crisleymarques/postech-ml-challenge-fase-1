    "print(\"Missing values com percentual > 0\")\n",
    "missing_values = (\n",
    "    df.isna()\n",
    "    .agg([\"sum\", \"mean\"])\n",
    "    .T.rename(columns={\"sum\": \"missing_count\", \"mean\": \"missing_rate\"})\n",
    "    .query(\"missing_count > 0\")\n",
    "    .sort_values(\"missing_rate\", ascending=False)\n",
    ")\n",
    "missing_values[\"missing_percentage\"] = missing_values[\"missing_rate\"] * 100\n",
    "display(missing_values)\n",
    "\n",
    "if not missing_values.empty:\n",
    "    plt.figure(figsize=(10, 5))\n",
    "    sns.barplot(\n",
    "        data=missing_values.reset_index().rename(columns={\"index\": \"column\"}),\n",
    "        x=\"missing_percentage\",\n",
    "        y=\"column\",\n",
    "        color=\"coral\",\n",
    "    )\n",
    "    plt.title(\"Missing values por coluna\")\n",
    "    plt.xlabel(\"Missing values (%)\")\n",
    "    plt.ylabel(\"Coluna\")\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "print(\"\\nVisão estrutural do DataFrame\")\n",
    "df.info()\n",
    "\n",
    "print(\"\\nEstatísticas descritivas das variáveis numéricas\")\n",
    "numeric_describe = df.select_dtypes(include=[np.number]).describe().T\n",
    "numeric_describe[\"missing_count\"] = df.select_dtypes(include=[np.number]).isna().sum()\n",
    "display(numeric_describe)\n",
    "\n",
    "print(\"\\nResumo das variáveis categóricas\")\n",
    "categorical_describe = df.select_dtypes(exclude=[np.number]).describe().T\n",
    "if not categorical_describe.empty:\n",
    "    categorical_describe[\"missing_count\"] = df.select_dtypes(exclude=[np.number]).isna().sum()\n",
    "    display(categorical_describe)\n",
    "else:\n",
    "    print(\"Sem variáveis categóricas.\")\n"
