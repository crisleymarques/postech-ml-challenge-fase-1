        "df = df_raw.copy()\n",
        "\n",
        "if TARGET_COLUMN not in df.columns:\n",
        "    if \"ChurnValue\" in df.columns:\n",
        "        df[TARGET_COLUMN] = (pd.to_numeric(df[\"ChurnValue\"], errors=\"coerce\") > 0).astype(int)\n",
        "    elif \"ChurnLabel\" in df.columns:\n",
        "        df[TARGET_COLUMN] = df[\"ChurnLabel\"].map({\"Yes\": 1, \"No\": 0}).astype(int)\n",
        "    else:\n",
        "        raise ValueError(\"Não foi possível criar o alvo target.\")\n",
        "else:\n",
        "    df[TARGET_COLUMN] = pd.to_numeric(df[TARGET_COLUMN], errors=\"raise\").astype(int)\n",
        "\n",
        "readiness = pd.DataFrame(\n",
        "    {\n",
        "        \"metric\": [\n",
        "            \"rows\",\n",
        "            \"columns\",\n",
        "            \"duplicate_rows\",\n",
        "            \"missing_cells\",\n",
        "            \"missing_rate\",\n",
        "            \"target_positive_rate\",\n",
        "        ],\n",
        "        \"value\": [\n",
        "            len(df),\n",
        "            df.shape[1],\n",
        "            int(df.duplicated().sum()),\n",
        "            int(df.isna().sum().sum()),\n",
        "            float(df.isna().mean().mean()),\n",
        "            float(df[TARGET_COLUMN].mean()),\n",
        "        ],\n",
        "    }\n",
        ")\n",
        "display(readiness)\n",
        "\n",
        "dtype_summary = (\n",
        "    df.dtypes.astype(str)\n",
        "    .value_counts()\n",
        "    .rename_axis(\"dtype\")\n",
        "    .reset_index(name=\"columns\")\n",
        ")\n",
        "display(dtype_summary)\n",
        "\n",
        "missing_summary = (\n",
        "    df.isna()\n",
        "    .mean()\n",
        "    .sort_values(ascending=False)\n",
        "    .rename(\"missing_rate\")\n",
        "    .reset_index()\n",
        "    .rename(columns={\"index\": \"column\"})\n",
        ")\n",
        "display(missing_summary.head(20))\n",
        "\n",
        "cardinality = (\n",
        "    df.nunique(dropna=False)\n",
        "    .sort_values(ascending=False)\n",
        "    .rename(\"unique_values\")\n",
        "    .reset_index()\n",
        "    .rename(columns={\"index\": \"column\"})\n",
        ")\n",
        "display(cardinality.head(20))"
      ]
    },
