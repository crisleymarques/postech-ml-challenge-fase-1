      "source": [
        "from sklearn.feature_selection import SelectKBest, f_classif, mutual_info_classif\n",
        "\n",
        "feature_selection_rows = []\n",
        "for score_name, score_func in {\n",
        "    \"f_classif\": f_classif,\n",
        "    \"mutual_info\": mutual_info_classif,\n",
        "}.items():\n",
        "    pipeline = Pipeline(\n",
        "        steps=[\n",
        "            (\"preprocess\", preprocessor),\n",
        "            (\"select\", SelectKBest(score_func=score_func, k=min(30, X_train.shape[1]))),\n",
        "            (\n",
        "                \"model\",\n",
        "                LogisticRegression(\n",
        "                    class_weight=\"balanced\",\n",
        "                    max_iter=2000,\n",
        "                    random_state=RANDOM_SEED,\n",
        "                ),\n",
        "            ),\n",
        "        ]\n",
        "    )\n",
        "    pipeline.fit(X_train, y_train)\n",
        "    y_score = positive_scores(pipeline, X_test)\n",
        "    feature_selection_rows.append(\n",
        "        {\n",
        "            \"selector\": score_name,\n",
        "            **evaluate_predictions(y_test, y_score, threshold=0.5),\n",
        "        }\n",
        "    )\n",
        "\n",
        "feature_selection_results = pd.DataFrame(feature_selection_rows).sort_values(\"pr_auc\", ascending=False).reset_index(drop=True)\n",
        "display(feature_selection_results)"
      ]
    },
