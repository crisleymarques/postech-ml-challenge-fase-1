      "source": [
        "from mlflow.tracking import MlflowClient\n",
        "\n",
        "mlflow.set_tracking_uri(MLFLOW_TRACKING_URI)\n",
        "mlflow.set_experiment(MLFLOW_EXPERIMENT_NAME)\n",
        "\n",
        "summary_cols = [\"model\", \"pr_auc\", \"roc_auc\", \"f1\", \"precision\", \"recall\"]\n",
        "consolidated_summary = holdout_results[summary_cols].copy()\n",
        "\n",
        "with mlflow.start_run(run_name=\"etapa1-extended-analysis\") as extended_run:\n",
        "    mlflow.log_param(\"models_count\", int(len(models)))\n",
        "    mlflow.log_param(\"best_tree_model\", best_tree_model_name)\n",
        "    mlflow.log_metric(\"extended_best_pr_auc\", float(holdout_results.iloc[0][\"pr_auc\"]))\n",
        "    mlflow.log_metric(\"extended_best_roc_auc\", float(holdout_results.iloc[0][\"roc_auc\"]))\n",
        "    mlflow.log_metric(\"feature_selection_best_pr_auc\", float(feature_selection_results.iloc[0][\"pr_auc\"]))\n",
        "\n",
        "    for i, row in consolidated_summary.reset_index(drop=True).iterrows():\n",
        "        prefix = f\"extended_rank_{i+1}_{row['model']}\"\n",
        "        mlflow.log_metric(f\"{prefix}_pr_auc\", float(row[\"pr_auc\"]))\n",
        "        mlflow.log_metric(f\"{prefix}_roc_auc\", float(row[\"roc_auc\"]))\n",
        "\n",
        "    mlflow.log_figure(fig_perm, \"figures/permutation_importance_top20.png\")\n",
        "\n",
        "    consolidated_summary_path = PROJECT_ROOT / \"data\" / \"processed\" / \"extended_baselines_summary.csv\"\n",
        "    feature_selection_path = PROJECT_ROOT / \"data\" / \"processed\" / \"feature_selection_summary.csv\"\n",
        "    perm_path = PROJECT_ROOT / \"data\" / \"processed\" / \"permutation_importance_top20.csv\"\n",
        "\n",
        "    consolidated_summary.to_csv(consolidated_summary_path, index=False)\n",
        "    feature_selection_results.to_csv(feature_selection_path, index=False)\n",
        "    perm_importance_df.to_csv(perm_path, index=False)\n",
        "\n",
        "    mlflow.log_artifact(str(consolidated_summary_path), artifact_path=\"extended\")\n",
        "    mlflow.log_artifact(str(feature_selection_path), artifact_path=\"extended\")\n",
        "    mlflow.log_artifact(str(perm_path), artifact_path=\"extended\")\n",
        "\n",
        "# Registro opcional do melhor baseline no Model Registry (desligado por padrão)\n",
        "REGISTER_BASELINE = False\n",
        "if REGISTER_BASELINE:\n",
        "    baseline_to_register = holdout_results.iloc[0][\"model\"]\n",
        "    baseline_uri = f\"runs:/{extended_run.info.run_id}/model-{baseline_to_register}\"\n",
        "    print(\"Defina manualmente o model_uri correto de uma run com artefato de modelo antes de registrar.\")\n",
        "\n",
        "client = MlflowClient(tracking_uri=MLFLOW_TRACKING_URI)\n",
        "experiment = client.get_experiment_by_name(MLFLOW_EXPERIMENT_NAME)\n",
        "runs = client.search_runs(\n",
        "    experiment_ids=[experiment.experiment_id],\n",
        "    order_by=[\"attributes.start_time DESC\"],\n",
        "    max_results=8,\n",
        ")\n",
        "\n",
        "run_rows = []\n",
        "for run in runs:\n",
        "    run_rows.append(\n",
        "        {\n",
        "            \"run_id\": run.info.run_id,\n",
        "            \"run_name\": run.data.tags.get(\"mlflow.runName\", \"\"),\n",
        "            \"start_time\": run.info.start_time,\n",
        "            \"holdout_pr_auc\": run.data.metrics.get(\"holdout_pr_auc\"),\n",
        "            \"extended_best_pr_auc\": run.data.metrics.get(\"extended_best_pr_auc\"),\n",
        "        }\n",
        "    )\n",
        "\n",
        "runs_overview = pd.DataFrame(run_rows)\n",
        "display(runs_overview)"
      ]
    },
