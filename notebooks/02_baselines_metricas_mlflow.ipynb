        "from sklearn.inspection import permutation_importance\n",
        "\n",
        "candidate_tree_models = holdout_results[holdout_results[\"model\"].isin([\"random_forest\"])].copy()\n",
        "if candidate_tree_models.empty:\n",
        "    raise RuntimeError(\"Nenhum baseline de árvore encontrado para interpretabilidade.\")\n",
        "\n",
        "best_tree_model_name = candidate_tree_models.sort_values(\"pr_auc\", ascending=False).iloc[0][\"model\"]\n",
        "best_tree_pipeline = fitted_pipelines[best_tree_model_name]\n",
        "\n",
        "perm = permutation_importance(\n",
        "    best_tree_pipeline,\n",
        "    X_test,\n",
        "    y_test,\n",
        "    n_repeats=10,\n",
        "    random_state=RANDOM_SEED,\n",
        "    scoring=\"average_precision\",\n",
        "    n_jobs=-1,\n",
        ")\n",
        "\n",
        "# Permutation importance permutes colunas de X_test (entrada do pipeline), não colunas pós-OHE.\n",
        "feature_names = np.asarray(best_tree_pipeline.feature_names_in_, dtype=object)\n",
        "perm_importance_df = (\n",
        "    pd.DataFrame(\n",
        "        {\n",
        "            \"feature\": feature_names,\n",
        "            \"importance_mean\": perm.importances_mean,\n",
        "            \"importance_std\": perm.importances_std,\n",
        "        }\n",
        "    )\n",
        "    .sort_values(\"importance_mean\", ascending=False)\n",
        "    .head(20)\n",
        "    .reset_index(drop=True)\n",
        ")\n",
        "\n",
        "fig_perm, ax_perm = plt.subplots(figsize=(10, 7))\n",
        "ax_perm.barh(\n",
        "    perm_importance_df[\"feature\"].iloc[::-1],\n",
        "    perm_importance_df[\"importance_mean\"].iloc[::-1],\n",
        "    xerr=perm_importance_df[\"importance_std\"].iloc[::-1],\n",
        ")\n",
        "ax_perm.set_title(f\"Top 20 permutation importances - {best_tree_model_name}\")\n",
        "ax_perm.set_xlabel(\"Mean decrease em PR-AUC\")\n",
        "plt.tight_layout()\n",
        "\n",
        "display(perm_importance_df)\n",
        "plt.show()"
      ]
    },
